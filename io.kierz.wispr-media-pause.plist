<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.kierz.wispr-media-pause</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/wispr-media-pause</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/wispr-media-pause.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/wispr-media-pause.log</string>
</dict>
</plist>
